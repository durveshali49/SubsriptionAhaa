# Server-only settings. Copy to .env and enter real values locally.
DATABASE_PATH=data/ahaa.sqlite3
# Leave blank for local SQLite. Use Supabase Connect > Session pooler.
SUPABASE_DATABASE_URL=
# Optional path to the Supabase CA certificate for TLS verification.
SUPABASE_SSL_ROOT_CERT=
COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost
